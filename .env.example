# The shared password everyone types in to reach the app.
APP_PASSWORD=change-me

# A random secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# Never reuse APP_PASSWORD as this value.
SESSION_SECRET=change-me-too

# Supabase project credentials, for cross-device sync.
# Find these in your Supabase project: Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the service_role key (Settings -> API -> Project API keys), or the newer
# "secret" key (sb_secret_...) if your project has migrated to the new key format.
# Either env var name works — only set one.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
